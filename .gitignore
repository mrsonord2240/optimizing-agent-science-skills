# Heavy or reproducible artefacts live outside git (see README, "What is deliberately not here").

# Raw run outputs and generated test data
audits/*/*/runs/
audits/*/*/rerun/
audits/*/*/data/*
!audits/*/*/data/*.py
!audits/*/*/data/*.R
!audits/*/*/data/README.md

# Downloaded public datasets, runtimes and installed binaries
public-data/
environments/**/venv/
environments/**/R-lib/
environments/**/tools/
*.raw
*.mzML
*.mzXML
*.fasta
*.tar.bz2
*.msi
*.zip

# ...except inside the bioSkills export, which is a faithful copy of the fork tree: a Skill's own
# shipped example data is part of what it ships, and dropping it breaks "shipped means present"
# for the exported Skill while the fork still passes. Three .fasta examples were being lost here.
!skills/bioSkills/**/*.fasta

# Editor and OS noise
node_modules/
__pycache__/
.Rhistory
.DS_Store
Thumbs.db



# pybiomart drops its dataset cache into the process working directory
.pybiomart.sqlite

# Datasets and outputs dropped in the repo root by audit runs (hundreds of MB; refetch, never commit)
/data/
/pertpy_de_results.tsv
